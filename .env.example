# Copy to backend/.env and set a unique APP_SECRET for local use.
DATABASE_URL=postgresql+psycopg://smartslot:smartslot@localhost:5432/smartslot
APP_SECRET=replace-with-a-long-random-secret
BUSINESS_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173
DEMO_BUSINESS_ID=1

# Backend-only settings; put these in backend/.env, not in the React frontend.
GOOGLE_ROUTES_API_KEY=
AUTO_ALLOCATOR_ENABLED=true
AUTO_ALLOCATOR_INTERVAL_SECONDS=60
