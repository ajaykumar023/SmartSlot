DATABASE_URL=postgresql+psycopg://smartslot:smartslot@localhost:5432/smartslot
APP_SECRET=replace-with-a-long-random-secret
BUSINESS_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173
DEMO_BUSINESS_ID=1

# Live TomTom Routing API: keep this key on the FastAPI server.
# Use a separate key for browser map tiles in frontend/.env.
TOMTOM_ROUTING_API_KEY=

# Background waitlist allocation; sweeps expired offers and released bookings.
AUTO_ALLOCATOR_ENABLED=true
AUTO_ALLOCATOR_INTERVAL_SECONDS=60
